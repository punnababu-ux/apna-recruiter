# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Workspace deps — the root rule is anchored, so packages/*/node_modules was
# being tracked (44 files).
**/node_modules

# Build output. The app never reads it: tsconfig maps @apna/design-system to
# src, next.config transpiles the package, and `npm run build` builds it first.
# Tracking it only produced merge conflicts on every design-system change.
/packages/design-system/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local agent/editor configs
.claude/
.vscode/
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts

# figma scraper / tokens dump
poneglyph-figma-*.json
scripter-*.js
figma-*.js
